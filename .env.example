# ComfyUI for DGX Spark (Blackwell GB10)
# Based on nvidia/cuda:13.1.1-devel-ubuntu24.04 container
# Customize your paths and rename this to .env
# I suggest creating a comfyui folder in your home

# Base path where your existing ComfyUI installation lives (for models)
COMFYUI_HOST_PATH=/home/user/comfyui

# Base path for ComfyUI data (custom_nodes, outputs, inputs, etc.)
# Compose bind-mounts these subdirectories of it, so create them first or docker
# will make them for you as root:
#   mkdir -p "$COMFYUI_DATA_PATH"/{user,custom_nodes,output,input,workflows,wheels,cache,home}
COMFYUI_DATA_PATH=/home/user/comfyui

# ComfyUI settings
COMFYUI_PORT=8188

# Run the container as this uid/gid instead of root, so everything it writes
# into the bind mounts above is owned by you. Set these to the output of `id -u`
# and `id -g`. They are baked into the image, so changing them means
# `docker compose build`, not just a restart.
#
# First time you switch away from root, take ownership of the existing data:
#   sudo chown -R "$(id -u):$(id -g)" /path/to/your/comfyui
PUID=1000
PGID=1000

# Flags for Grace-Blackwell unified memory architecture
# Key: DON'T use --gpu-only - it fights the unified memory fabric
# --disable-pinned-memory: reduces overhead on unified fabric
# --use-sage-attention: the sm_121 SageAttention build; entrypoint.sh verifies
#   the kernel actually runs before launching, so a bad build fails loudly at
#   startup instead of hanging at the first sampler step
# --bf16-unet/-vae/-text-enc: the GB10 fast path
#
# Deliberately NOT here, all three verified against ComfyUI source:
# --force-fp16: cli_args.py sets fp16_unet=True and should_use_fp16() then
#   returns True unconditionally. --bf16-unet still wins for the unet, so you
#   end up with bf16 weights on fp16 compute paths — casts everywhere and the
#   fp16 path is the one that NaNs on Blackwell.
# --dont-upcast-attention: makes get_attn_precision() return None, which
#   OVERRIDES the fp32 attention some models explicitly ask for. Linux already
#   defaults to no upcasting, so this can only remove a safety net (black images).
# --disable-mmap: was paired with a utils.py patch in the Dockerfile that
#   rewrote copy=True to copy=False on the one line inside the `if DISABLE_MMAP:`
#   branch. safe_open() has already placed the tensor on the target device by
#   then, so copy=False made the branch a no-op and the two cancelled out. The
#   patch has been removed; if you re-add the flag, do it without the patch.
#
# Optional, uncomment if you hit the overcommit freeze on large models:
#   --reserve-vram 8      keep 8 GB of the unified pool free for the OS
#   --disable-dynamic-vram  fall back to estimate-based model loading
#
# Untested performance flags, none enabled by default. Measure before keeping —
# ComfyUI itself describes --fast as "untested and potentially quality
# deteriorating". See PerformanceFeature in comfy/cli_args.py.
#   --fast autotune            cuBLAS/cuDNN autotuning; likeliest of the four to help
#   --fast fp8_matrix_mult     only does anything for fp8 checkpoints
#   --fast fp16_accumulation   NO EFFECT under --bf16-unet: it relaxes fp16 matmul
#                              accumulation, and the unet is not running fp16
#   --fast cublas_ops          needs the cublas_ops package, which is not installed
#   --fast-disk                prefers disk-backed offload over unpinned RAM; only
#                              worth trying if your models sit on fast NVMe
#
# NOT recommended on this hardware:
#   --enable-triton-backend    switches comfy-kitchen to its Triton kernels. That
#                              path is upstream's ROCm/matrix-core default (see
#                              comfy/quant_ops.py); on CUDA the `cuda` backend is
#                              already active and exposes a superset of its ops.
COMFYUI_FLAGS=--listen 0.0.0.0 --port 8188 --preview-method auto --disable-pinned-memory --use-sage-attention --bf16-unet --bf16-vae --bf16-text-enc

# torch.compile / TorchInductor.
# Leave EMPTY (the default) to let entrypoint.sh decide: it runs a real
# torch.compile on this GPU at startup and enables it only if that succeeds.
# Triton used to fail on GB10 because PyTorch's bundled ptxas is CUDA 12.8-era
# and does not know sm_121a; the image now points TRITON_PTXAS_PATH at the CUDA
# 13.1 ptxas, which does. Look for "[entrypoint] Triton:" in the startup logs.
# Set to 1 to skip the probe and force torch.compile off.
TORCH_COMPILE_DISABLE=

# PyTorch CUDA allocator tuning. Unset by default (allocator backend "native").
# expandable_segments:True is the usual first knob against fragmentation on the
# unified memory pool; worth measuring if large models stall or OOM.
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Custom node requirements are installed only when they change — the entrypoint
# hashes every custom_nodes/*/requirements.txt together with the image build id.
# Set to 1 to force a reinstall on the next start.
# FORCE_REQS_INSTALL=1

# Build refs. These are pinned commits/tags, NOT branches: tracking a branch
# means a rebuild silently produces a different image, and a broken SageAttention
# build is only discoverable at runtime. Bump them deliberately and rebuild.
COMFYUI_REF=v0.31.0
# SageAttention is compiled for sm_121 at build time. Currently v2.2.0.
SAGEATTN_REF=d1a57a546c3d395b1ffcbeecc66d81db76f3b4b5

# ONNX Runtime is compiled from source for sm_121 (~45-60 min) because no
# aarch64 onnxruntime-gpu wheel exists on PyPI. It lives in its own Dockerfile
# and is built separately — `docker compose build onnxruntime` — so the hour
# is paid once and never again on a normal `docker compose build`.
# Lower ONNXRUNTIME_JOBS if nvcc runs out of memory during the build.
ONNXRUNTIME_REF=v1.28.0
ONNXRUNTIME_JOBS=8
# Tag of the wheel image. Bump it alongside ONNXRUNTIME_REF and rebuild the
# onnxruntime service; the comfyui build then picks up the new wheel.
ONNXRUNTIME_IMAGE=onnxruntime-gb10:1.28.0-cu131-sm121

# ComfyUIMini - Mobile-friendly UI (optional)
# Access at http://<host>:3000
COMFYUIMINI_PORT=3000
COMFYUIMINI_REF=main
