# ---- ONNX Runtime GPU (aarch64 + sm_121) ----
# Microsoft publishes no linux-aarch64 wheels for onnxruntime-gpu (checked through
# 1.28.0), so nodes like comfy-mtb / Impact Pack silently fall back to CPU ONNX.
# v1.28.0 builds clean against CUDA 13.1 on GB10 and is verified working.
#
# This lives in its own Dockerfile because the compile takes ~45-60 minutes and
# has nothing to do with the rest of the image. Build it once:
#
#   docker compose build onnxruntime
#
# The result is a scratch image containing nothing but the wheel, which the main
# Dockerfile pulls in via COPY --from. Rebuild it only when ONNXRUNTIME_REF or
# the CUDA base image changes.
#
# To get the wheel out onto the host instead of into an image:
#   docker build -f Dockerfile.onnxruntime --output type=local,dest=./wheels .
FROM nvidia/cuda:13.1.1-devel-ubuntu24.04 AS builder

ARG DEBIAN_FRONTEND=noninteractive
ARG ONNXRUNTIME_REF=v1.28.0
# nvcc peaks at several GB per translation unit — too many jobs OOMs the build
ARG ONNXRUNTIME_JOBS=8

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl ca-certificates \
    python3 python3-pip python3-venv python3-dev \
    build-essential ninja-build cmake pkg-config \
    libcudnn9-dev-cuda-13 libcudnn9-headers-cuda-13 \
    && rm -rf /var/lib/apt/lists/*

# cuDNN installs in Debian multiarch layout (/usr/include/aarch64-linux-gnu,
# /usr/lib/aarch64-linux-gnu), but ORT's cuDNN.cmake searches <cudnn_home>/include
# and <cudnn_home>/lib{,64} and then does a REQUIRED file(READ) on cudnn_version.h.
# Symlink both into place so --cudnn_home /usr resolves without relying on CMake's
# implicit multiarch fallback — a miss here fails the build at the CUDA EP step.
RUN ln -sf /usr/include/aarch64-linux-gnu/cudnn*.h /usr/include/ && \
    ln -sf /usr/lib/aarch64-linux-gnu/libcudnn*.so* /usr/lib/ && \
    test -r /usr/include/cudnn_version.h && test -r /usr/lib/libcudnn.so

ENV VENV=/opt/venv
RUN python3 -m venv $VENV
ENV PATH="$VENV/bin:$PATH"
# cmake from pip: Ubuntu 24.04 ships 3.28.3 and ORT requires 3.28, so apt's
# version sits exactly on the floor. The venv is first on PATH, so build.sh
# picks this one up instead.
RUN pip install -U pip setuptools wheel packaging numpy cmake

RUN git clone --recursive --depth 1 --branch ${ONNXRUNTIME_REF} \
    https://github.com/microsoft/onnxruntime.git /opt/onnxruntime

WORKDIR /opt/onnxruntime
# CMAKE_CUDA_ARCHITECTURES=121 is the critical bit: GB10 is compute 12.1, and a
# binary built for 12.0 has no matching cubin (it would fall back to PTX JIT).
RUN ./build.sh \
    --config Release \
    --use_cuda \
    --cuda_home /usr/local/cuda \
    --cudnn_home /usr \
    --build_shared_lib \
    --build_wheel \
    --skip_tests \
    --allow_running_as_root \
    --parallel ${ONNXRUNTIME_JOBS} \
    --nvcc_threads 1 \
    --cmake_extra_defines CMAKE_CUDA_ARCHITECTURES=121 \
    && mkdir -p /wheels \
    && cp build/Linux/Release/dist/onnxruntime_gpu-*.whl /wheels/

# Wheel only — the ~10 GB build tree is discarded. The image is not runnable;
# it exists purely as a COPY --from source (and as a `--output` payload).
FROM scratch
COPY --from=builder /wheels /wheels
